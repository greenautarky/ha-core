        <mxCell id="arrow-ci-ghcr-label" value="push" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#2B5A2A;fontStyle=1;" vertex="1" connectable="0" parent="arrow-ci-ghcr">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ==================== VERSION REPO ==================== -->
        <mxCell id="version-repo" value="&lt;b&gt;greenautarky/haos-version&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;stable.json:&lt;br&gt;images.core → ghcr.io/greenautarky/...&lt;br&gt;homeassistant.tinker → 2025.11.0-ga.X&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ==================== DEPLOYMENT PATHS ==================== -->

        <!-- Method A: Manual Testing -->
        <mxCell id="deploy-a-group" value="Method A: Manual Testing" style="swimlane;startSize=25;fillColor=#FFE0B2;strokeColor=#E89B30;fontStyle=1;fontSize=12;fontColor=#2B5A2A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="560" height="200" as="geometry" />
        </mxCell>

        <mxCell id="da-step1" value="docker pull ghcr.io/greenautarky/&lt;br&gt;tinker-homeassistant:latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="deploy-a-group">
          <mxGeometry x="20" y="35" width="240" height="35" as="geometry" />
        </mxCell>
        <mxCell id="da-step2" value="docker tag → ghcr.io/home-assistant/&lt;br&gt;tinker-homeassistant:2025.11.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="deploy-a-group">
          <mxGeometry x="20" y="80" width="240" height="35" as="geometry" />
        </mxCell>
        <mxCell id="da-step3" value="ha core rebuild" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontSize=10;fontStyle=1;" vertex="1" parent="deploy-a-group">
          <mxGeometry x="20" y="125" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="da-note" value="&lt;font color=&quot;#E89B30&quot;&gt;Stock HAOS only.&lt;br&gt;Supervisor expects stock image name.&lt;br&gt;Retag fakes it.&lt;br&gt;&lt;br&gt;⚠ Auto-update will overwrite!&lt;/font&gt;" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="deploy-a-group">
          <mxGeometry x="300" y="35" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Arrow: GHCR → Method A -->
        <mxCell id="arrow-ghcr-a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E89B30;strokeWidth=2;dashed=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ghcr" target="deploy-a-group">
          <mxGeometry relative="1" as="geometry">
