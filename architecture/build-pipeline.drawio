        <!-- Arrow: Version repo → Method B -->
        <mxCell id="arrow-ver-b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673A6;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="version-repo" target="deploy-b-group">
