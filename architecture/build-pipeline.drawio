        <!-- ==================== GHCR REGISTRY ==================== -->
        <mxCell id="ghcr" value="&lt;b&gt;GHCR Registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;ghcr.io/greenautarky/&lt;br&gt;tinker-homeassistant&lt;br&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Tags: latest, 2025.11.0-ga.X, dev-&amp;lt;sha&amp;gt;&lt;br&gt;Platform: linux/arm/v7&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E8F5E9;strokeColor=#2B5A2A;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1020" y="100" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Arrow: CI → GHCR -->
        <mxCell id="arrow-ci-ghcr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B5A2A;strokeWidth=2;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci-group" target="ghcr">
          <mxGeometry relative="1" as="geometry" />
