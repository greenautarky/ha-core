        <!-- ==================== DEVICE ==================== -->
        <mxCell id="device" value="&lt;b&gt;iHost (Sonoff RV1126)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;HAOS + Supervisor + HA Core container&lt;br&gt;arch: armv7, machine: tinker&lt;br&gt;SSH port: 22222&lt;/font&gt;" style="shape=mxgraph.cisco.computers_and_peripherals.generic_appliance;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#2B5A2A;fontSize=11;verticalAlign=bottom;spacingBottom=5;" vertex="1" parent="1">
