<mxfile host="app.diagrams.net" modified="2026-03-03" agent="Claude" version="24.0.0" type="device">
  <diagram id="build-pipeline" name="Build Pipeline">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;greenautarky KI-Butler — Build &amp; Deploy Pipeline&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#2B5A2A;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== SOURCE REPOS ==================== -->
        <mxCell id="repos-group" value="Source Repositories" style="swimlane;startSize=30;fillColor=#F4F9F4;strokeColor=#2B5A2A;fontStyle=1;fontSize=14;fontColor=#2B5A2A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="500" height="280" as="geometry" />
        </mxCell>

        <!-- Frontend repo -->
        <mxCell id="frontend-repo" value="&lt;b&gt;greenautarky/frontend&lt;/b&gt;&lt;br&gt;Branch: ga/custom-onboarding&lt;br&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;src/onboarding/*.ts&lt;br&gt;ga-branding.ts (CI colors, logos)&lt;br&gt;onboarding-welcome.ts&lt;br&gt;onboarding-create-user.ts&lt;br&gt;onboarding-analytics.ts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;fontSize=11;" vertex="1" parent="repos-group">
          <mxGeometry x="20" y="40" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- Core repo -->
        <mxCell id="core-repo" value="&lt;b&gt;greenautarky/ha-core&lt;/b&gt;&lt;br&gt;Branch: ga/custom-onboarding&lt;br&gt;&lt;hr&gt;&lt;font size=&quot;1&quot;&gt;components/greenautarky_telemetry/&lt;br&gt;components/onboarding/manifest.json&lt;br&gt;config.py (DEFAULT_CONFIG)&lt;br&gt;.github/workflows/build-ga-core.yml&lt;br&gt;Dockerfile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;fontSize=11;" vertex="1" parent="repos-group">
          <mxGeometry x="260" y="40" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- git push arrows -->
        <mxCell id="push-frontend" value="git push" style="text;html=1;align=center;fontSize=10;fontColor=#E89B30;fontStyle=1;" vertex="1" parent="repos-group">
          <mxGeometry x="70" y="185" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="push-core" value="git push" style="text;html=1;align=center;fontSize=10;fontColor=#E89B30;fontStyle=1;" vertex="1" parent="repos-group">
          <mxGeometry x="320" y="185" width="60" height="20" as="geometry" />
        </mxCell>

        <!-- Manual trigger note -->
        <mxCell id="manual-note" value="&lt;font color=&quot;#E89B30&quot;&gt;Frontend push alone does NOT&lt;br&gt;trigger CI. Must also push core&lt;br&gt;or use workflow_dispatch.&lt;/font&gt;" style="text;html=1;align=center;fontSize=10;fontStyle=2;" vertex="1" parent="repos-group">
          <mxGeometry x="100" y="210" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== CI BUILD ==================== -->
        <mxCell id="ci-group" value="GitHub Actions CI" style="swimlane;startSize=30;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;fontSize=14;fontColor=#2B5A2A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="340" height="280" as="geometry" />
        </mxCell>

        <mxCell id="ci-step1" value="1. Checkout core + frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="40" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ci-step2" value="2. yarn install + build_frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="70" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ci-step3" value="3. python3 -m build → frontend .whl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="100" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ci-step4" value="4. QEMU + Buildx (linux/arm/v7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="130" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ci-step5" value="5. docker build (Dockerfile + .whl + core)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="160" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ci-step6" value="6. docker push → GHCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontSize=10;fontStyle=1;" vertex="1" parent="ci-group">
          <mxGeometry x="20" y="190" width="300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="ci-time" value="~24 min total" style="text;html=1;align=center;fontSize=10;fontColor=#888;" vertex="1" parent="ci-group">
          <mxGeometry x="100" y="225" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Arrow: repos → CI -->
        <mxCell id="arrow-repo-ci" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B5A2A;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="repos-group" target="ci-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-repo-ci-label" value="triggers" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#2B5A2A;fontStyle=1;" vertex="1" connectable="0" parent="arrow-repo-ci">
          <mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
