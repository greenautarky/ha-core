              <mxPoint x="1020" y="410" />
              <mxPoint x="320" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow-ghcr-a-label" value="docker pull" style="edgeLabel;html=1;align=center;fontSize=10;fontColor=#E89B30;fontStyle=1;" vertex="1" connectable="0" parent="arrow-ghcr-a">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Method B: Production HAOS -->
        <mxCell id="deploy-b-group" value="Method B: Production (greenautarky HAOS)" style="swimlane;startSize=25;fillColor=#E8F5E9;strokeColor=#2B5A2A;fontStyle=1;fontSize=12;fontColor=#2B5A2A;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="440" width="560" height="200" as="geometry" />
        </mxCell>

        <mxCell id="db-step1" value="Supervisor reads version URL&lt;br&gt;→ greenautarky/haos-version/stable.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="deploy-b-group">
          <mxGeometry x="20" y="35" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="db-step2" value="Resolves: ghcr.io/greenautarky/&lt;br&gt;tinker-homeassistant:2025.11.0-ga.X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;fontSize=10;" vertex="1" parent="deploy-b-group">
          <mxGeometry x="20" y="80" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="db-step3" value="Auto-pull + update (or manual &quot;Update&quot; in UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontSize=10;fontStyle=1;" vertex="1" parent="deploy-b-group">
          <mxGeometry x="20" y="125" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="db-note" value="&lt;font color=&quot;#2B5A2A&quot;&gt;greenautarky HAOS build required.&lt;br&gt;hassio.mk points to our version URL.&lt;br&gt;No retagging needed.&lt;br&gt;&lt;br&gt;✓ Self-contained update pipeline&lt;/font&gt;" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="deploy-b-group">
          <mxGeometry x="300" y="35" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Arrow: GHCR → Method B -->
        <mxCell id="arrow-ghcr-b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B5A2A;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ghcr" target="deploy-b-group">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
