          <mxGeometry x="20" y="320" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Change: Release version -->
        <mxCell id="change-release" value="&lt;b&gt;Release New Version&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Tag a stable release for&lt;br&gt;production devices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Change: HAOS system -->
        <mxCell id="change-haos" value="&lt;b&gt;HAOS System Level&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Version URL, kernel, system&lt;br&gt;packages, partition layout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E89B30;fontSize=11;" vertex="1" parent="1">
