        <mxCell id="result-ota" value="&lt;b&gt;OTA&lt;/b&gt; (docker pull + rebuild)&lt;br&gt;&lt;font size=&quot;1&quot;&gt;~5 min on device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2B5A2A;fontSize=11;" vertex="1" parent="1">
