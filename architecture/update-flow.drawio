        <mxCell id="title" value="&lt;b&gt;What to Update When — Decision Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#2B5A2A;" vertex="1" parent="1">
