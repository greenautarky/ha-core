        <!-- ==================== COMMANDS ==================== -->
        <mxCell id="col-header-cmd" value="&lt;b&gt;Commands to Run&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;fontColor=#2B5A2A;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="cmd-ui" value="&lt;font face=&quot;monospace&quot; size=&quot;1&quot;&gt;cd frontend &amp;amp;&amp;amp; git push&lt;br&gt;gh workflow run build-ga-core.yml \&lt;br&gt;  -R greenautarky/ha-core \&lt;br&gt;  --ref ga/custom-onboarding \&lt;br&gt;  -f tag=2025.11.0-ga.X&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmd-backend" value="&lt;font face=&quot;monospace&quot; size=&quot;1&quot;&gt;cd ha-core &amp;amp;&amp;amp; git push&lt;br&gt;# CI auto-triggers on push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="225" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmd-config" value="&lt;font face=&quot;monospace&quot; size=&quot;1&quot;&gt;cd ha-core &amp;amp;&amp;amp; git push&lt;br&gt;# CI auto-triggers on push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="325" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cmd-release" value="&lt;font face=&quot;monospace&quot; size=&quot;1&quot;&gt;# After CI build completes:&lt;br&gt;Edit stable.json:&lt;br&gt;  homeassistant.tinker = 2025.11.0-ga.X&lt;br&gt;  core = 2025.11.0-ga.X&lt;br&gt;cd haos-version &amp;amp;&amp;amp; git push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cmd-haos" value="&lt;font face=&quot;monospace&quot; size=&quot;1&quot;&gt;# Requires full HAOS rebuild:&lt;br&gt;cd ha-operating-system&lt;br&gt;make ga_ihost_full_defconfig&lt;br&gt;make  # → .img file&lt;br&gt;# Flash to iHost via ga-flasher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="510" width="300" height="80" as="geometry" />
        </mxCell>

