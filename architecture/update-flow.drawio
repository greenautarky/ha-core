        <mxCell id="result-auto" value="&lt;b&gt;Auto-update&lt;/b&gt; (Supervisor)&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Next update check cycle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
